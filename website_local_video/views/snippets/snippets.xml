<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="snippets" inherit_id="website.snippets" name="Local Video Snippet">
        <xpath expr="//div[@id='snippet_structure']/div[hasclass('o_panel_body')]" position="inside">
            <t t-snippet="website_local_video.s_local_video"
               string="Local Video"
               t-thumbnail="/website_local_video/static/src/img/s_local_video.svg">
                <keywords>video, local, upload, media</keywords>
            </t>
        </xpath>
    </template>

    <template id="s_local_video_options" inherit_id="website.snippet_options" name="Local Video Options">
        <xpath expr="." position="inside">
            <div data-selector=".s_local_video" data-js="LocalVideo">
                <we-row string="Video">
                    <we-button class="o_we_bg_brand_primary"
                               data-upload-video="true"
                               data-no-preview="true">
                        Upload / replace
                    </we-button>
                </we-row>
                <we-select string="Width" data-apply-to=".o_local_video_container">
                    <we-button data-select-class="container">Contained</we-button>
                    <we-button data-select-class="container-fluid">Full width</we-button>
                </we-select>
                <we-select string="Aspect ratio" data-apply-to=".o_local_video_wrapper">
                    <we-button data-select-class="ratio-16x9">16:9</we-button>
                    <we-button data-select-class="ratio-4x3">4:3</we-button>
                    <we-button data-select-class="ratio-1x1">1:1</we-button>
                    <we-button data-select-class="o_local_video_ratio_portrait">9:16</we-button>
                </we-select>
                <we-select string="Fit" data-apply-to=".o_local_video_wrapper">
                    <we-button data-select-class="o_local_video_fit_contain">Contain</we-button>
                    <we-button data-select-class="o_local_video_fit_cover">Cover</we-button>
                </we-select>
                <we-checkbox string="Show controls" data-toggle-controls="true"/>
                <we-checkbox string="Autoplay (mutes video)" data-toggle-autoplay="true"/>
                <we-checkbox string="Loop" data-toggle-loop="true"/>
                <we-checkbox string="Muted" data-toggle-muted="true"/>
            </div>
        </xpath>
    </template>
</odoo>
